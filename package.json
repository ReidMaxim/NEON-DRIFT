{
  "name": "neon-drift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/playtest.mjs",
    "format": "prettier --write src tests scripts docs README.md index.html vite.config.js .github",
    "format:check": "prettier --check src tests scripts docs README.md index.html vite.config.js .github",
    "test:production": "node scripts/production-test.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2",
    "vite": "7.3.8"
  }
}
